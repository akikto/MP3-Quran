modules = ["python-base-3.13"]
[nix]
channel = "stable-25_05"
packages = ["jdk21", "xorg.libX11", "xorg.libxcb", "libGL", "libpulseaudio", "libz"]

[agent]
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 600000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Download Preview APK"

[[workflows.workflow]]
name = "Download Preview APK"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 scripts/apk-download-server.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
